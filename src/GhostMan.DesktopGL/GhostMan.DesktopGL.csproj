    <TargetFramework>net11.0</TargetFramework>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../GhostMan.Core/Content/Icon.ico</ApplicationIcon>
    <AssemblyName>GhostMan</AssemblyName>
    <AssemblyTitle>GhostMan</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <MonoGameContentReference Include="..\GhostMan.Core\Content\GhostMan.mgcb">
      <Link>Content\GhostMan.mgcb</Link>
